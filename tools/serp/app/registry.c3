module serp_tool;

import serp;
import std::collections::list;
import std::io::file;
import std::io::path;

// A command of the project, backed by `src/cmd/<ident>.c3`.
struct Entry
{
	String[] path;
	String   key;  // path joined with spaces; sorts parents before their children
	String   file;
}

struct Project
{
	String        dir;
	String        mod;
	List {Entry}  entries;
}

const String HEADER = "// serp:cmd ";

const String COMMAND_TEMPLATE = `// serp:cmd %s
module %s::commands;

import serp;

fn void? run_%s(Ctx* ctx)
{
	ctx.println("%s called")!;
}

fn Command* cmd_%s() => serp::cmd("%s", "%s", &run_%s);
`;

fn Entry make_entry(String[] path)
{
	return {.path = path, .key = join(path, " "), .file = string::tformat("%s.c3", ident(path))};
}

fn Entry* Project.find(&self, String key)
{
	foreach (&e : self.entries) if (e.key == key) return e;
	return null;
}

// Keeps parents before their children.
fn void Project.sort(&self)
{
	Entry[] a = self.entries.array_view();
	for (sz i = 1; i < a.len; i++)
	{
		Entry e = a[i];
		sz j = i;
		while (j > 0 && a[j - 1].key.compare_to(e.key) > 0)
		{
			a[j] = a[j - 1];
			j--;
		}
		a[j] = e;
	}
}

<*
 Reads the project: the module name from `src/commands.c3` and the commands
 from the `// serp:cmd <path>` header of every `src/cmd/*.c3` file. Files
 without the header are ignored.
*>
fn void? Project.open(&self, Ctx* ctx, String dir)
{
	self.dir = dir;
	self.entries.tinit(16);
	String registry = string::tformat("%s/src/commands.c3", dir);
	if (!file::exists(registry))
	{
		return ctx.fail("'%s' is not a serp project (no src/commands.c3); run `serp new` or use --dir", dir);
	}
	String text = (String)file::load_temp(registry)!;
	sz start = (text.index_of("module ") ?? 0) + 7;
	sz end = text.index_of("::commands") ?? text.len;
	self.mod = text[start:end - start];

	String cmd_dir = string::tformat("%s/src/cmd", dir);
	if (!file::exists(cmd_dir)) return;
	foreach (f : path::ls(tmem, path::tnew(cmd_dir)!, no_dirs: true, mask: "*.c3")!)
	{
		String src = (String)file::load_temp(string::tformat("%s/%s", cmd_dir, (String)f))!;
		if (!src.starts_with(HEADER)) continue;
		String line = src[HEADER.len..].tsplit("\n")[0].trim();
		String[] words = line.tsplit(" ", skip_empty: true);
		if (words.len) self.entries.push(make_entry(words));
	}
	self.sort();
}

<*
 Writes `src/cmd/<ident>.c3` for the entry. The description must not
 contain quotes or backslashes (checked by the callers).
*>
fn void? Project.write_command(&self, Entry* e, String desc)
{
	String id = ident(e.path);
	String name = e.path[e.path.len - 1];
	String text = string::tformat(COMMAND_TEMPLATE, e.key, self.mod, id, e.key, id, name, desc, id);
	file::save(string::tformat("%s/src/cmd/%s", self.dir, e.file), text)!;
}

// Rewrites `src/commands.c3` from the entries.
fn void? Project.write_registry(&self)
{
	DString s = dstring::temp();
	s.appendf("// Generated by `serp`: rewritten by `serp add` and `serp remove`. Do not edit.\nmodule %s::commands;\n\nimport serp;\n\nfn void register(Command* root)\n{\n", self.mod)!;
	foreach (e : self.entries)
	{
		String id = ident(e.path);
		if (e.path.len == 1)
		{
			s.appendf("\troot.add(cmd_%s());\n", id)!;
			continue;
		}
		s.append_string("\troot.add_at({");
		foreach (i, seg : e.path[:e.path.len - 1])
		{
			if (i) s.append_string(", ");
			s.appendf("\"%s\"", seg)!;
		}
		s.appendf("}, cmd_%s());\n", id)!;
	}
	s.append_string("}\n");
	file::save(string::tformat("%s/src/commands.c3", self.dir), s.str_view())!;
}
